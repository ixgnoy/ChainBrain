{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd mobile && npx expo start --web --port 8091"
      ],
      "port": 8091
    },
    {
      "name": "web-console",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm --dir web dev --port 5173 --strictPort"
      ],
      "port": 5173
    },
    {
      "name": "mobile-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd mobile && npx expo start --no-dev --minify --port 8092"
      ],
      "port": 8092
    }
  ]
}
