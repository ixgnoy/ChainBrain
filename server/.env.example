# the FISCO BCOS node (local: scripts/fisco/; hosted: the fisco-node service)
FISCO_RPC=http://127.0.0.1:8545
# optional: override contracts/deployments/20200.json
TOKEN_ADDRESS=
FACTORY_ADDRESS=
# FISCO has no explorer: tx links point at this wallet API's /api/tx/:hash
PUBLIC_API_URL=http://localhost:8787
# RPC URL the apps are told to use (never the server's own RPC, which may carry a provider key). Default: the chain's public RPC.
PUBLIC_RPC_URL=
# x402's facilitator code runs in-process as FACILITATOR_PK; scripts/fisco/deploy.sh gives it native balance.
# The model (src/llm.ts): LLM_PROVIDER = openrouter (default) | anthropic | scripted. Every model call uses it.
#   openrouter: OPENROUTER_API_KEY; LLM_MODEL = a preset name or slug, default claude-haiku-5.5 (anthropic/claude-haiku-5.5).
#     Presets: claude-haiku-5.5, glm-5.3-flash, deepseek-v4.1-flash, mimo-v2.6-pro, mimo-v2.6-flash. Any other id falls back to Haiku 5.5.
#     Per role: LLM_MODEL_AGENT_MODEL, LLM_MODEL_RULES_MODEL, ... (same names as the anthropic per-role ids below).
#   anthropic: ANTHROPIC_API_KEY and the per-role ids AGENT_MODEL, RULES_MODEL, RULES_CHECK_MODEL, POCKET_APP_MODEL, BRAIN_MEMORY_MODEL, RADAR_MODEL, SENTINEL_MODEL.
#   scripted: no model; the agent runs the scripted agent. A provider error also falls back to it, announced in the trace.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=claude-haiku-5.5
ANTHROPIC_API_KEY=
# Visitors and per-card agent keys
# AGENT_MASTER_KEY: 0x + 64 hex; generate once (0x$(openssl rand -hex 32)) and never change it (cards' agents derive from it)
AGENT_MASTER_KEY=
# VISITOR_STARTER=500         # HK$ minted to a new visitor
# VISITORS_PER_HOUR=60  RATE_LIMIT_PER_MIN=60  RATE_LIMIT_GET_PER_MIN=600
# DATA_DIR=                   # where visitors and card agents are kept (the Railway volume); default server/.data
# Revert reasons: the node gateway answers chainbrain_getRevertData from the native receipt
# FISCO_REVERT_RPC=https://fisco-node-production.up.railway.app
SELLERS_URL=http://localhost:4021
SELLERS_PORT=4021
PORT=8787
# filled by `pnpm wallets`
OWNER_PK=
AGENT_PK=
FORCE_PK=
FACILITATOR_PK=
SELLER_DATALITE_PK=
SELLER_DATAPRO_PK=
SELLER_HARBOUR_WINES_PK=
SELLER_SHADYFEED_PK=

# Radar (on-chain counterparty screening). All optional.
# RADAR_ADMIN=1               # demo only: allow POST /api/radar/admin/labels (risky labels only)
# RADAR_LABELS_FILE=          # JSON array of {address, category, name, source}, e.g. a sanctions export
# RADAR_REVIEW_AT=5           # score at which the owner must co-sign
# RADAR_BLOCK_AT=8            # score at which payment is refused
# RADAR_BACKFILL_BLOCKS=1800  # blocks of eHKD transfer history indexed at start
# RADAR_MODEL=claude-haiku-5-5  # model for "Ask Radar" (LLM_PROVIDER=anthropic only)

# Sentinel (watches every pocket; freezes on-chain with a freeze-only guardian key). All optional.
# SENTINEL_PK=                # the guardian key; deploy the factory with SENTINEL_ADDRESS = its address
# TYPESAFE_API_KEY=           # Jev (TypeSafe System One) answers the Sentinel's typed questions; without it the configured model stands in
# SENTINEL_MODEL=claude-haiku-5-5   # LLM_PROVIDER=anthropic only
