# fisco (default: local FISCO BCOS node + Mock e-HKD, see scripts/fisco/) or base-sepolia (USDC)
CHAIN=fisco
FISCO_RPC=http://127.0.0.1:8545
# optional: override contracts/deployments/20200.json
TOKEN_ADDRESS=
FACTORY_ADDRESS=
# FISCO has no explorer: tx links point at this wallet API's /api/tx/:hash
PUBLIC_API_URL=http://localhost:8787
# RPC URL the apps are told to use (never the server's own RPC, which may carry a provider key). Default: the chain's public RPC.
PUBLIC_RPC_URL=
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Base: hosted facilitator (default) or FACILITATOR=local to run x402's facilitator code in-process (needs FACILITATOR_PK with ETH).
# FISCO always runs it in-process (the hosted one does not know the chain); scripts/fisco/deploy.sh funds FACILITATOR.
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
SELLERS_URL=http://localhost:4021
SELLERS_PORT=4021
PORT=8787
# filled by `pnpm wallets`
OWNER_PK=
AGENT_PK=
FORCE_PK=
FACILITATOR_PK=
SELLER_DATALITE_PK=
SELLER_DATAPRO_PK=
SELLER_HARBOUR_WINES_PK=
SELLER_SHADYFEED_PK=

# Radar (on-chain counterparty screening). All optional.
# RADAR_ADMIN=1               # demo only: allow POST /api/radar/admin/labels (risky labels only)
# RADAR_LABELS_FILE=          # JSON array of {address, category, name, source}, e.g. a sanctions export
# RADAR_REVIEW_AT=5           # score at which the owner must co-sign
# RADAR_BLOCK_AT=8            # score at which payment is refused
# RADAR_BACKFILL_BLOCKS=1800  # blocks of USDC history indexed at start (~1 h on Base)
# RADAR_MODEL=claude-haiku-5-5  # model for "Ask Radar"

# Sentinel (watches every pocket; freezes on-chain with a freeze-only guardian key). All optional.
# SENTINEL_PK=                # the guardian key; deploy the factory with SENTINEL_ADDRESS = its address
# TYPESAFE_API_KEY=           # Jev (TypeSafe System One) answers the Sentinel's typed questions; without it Claude Haiku stands in
# SENTINEL_MODEL=claude-haiku-5-5
